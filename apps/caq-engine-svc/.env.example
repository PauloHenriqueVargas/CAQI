# Variáveis de ambiente do caq-engine-svc.
# Copie para .env (não commitado) e ajuste conforme o ambiente.

# Ambiente
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081

# Tenant (município)
CAQI_MUNICIPIO_ID=000000
CAQI_MUNICIPIO_NOME=Municipio Exemplo
CAQI_MUNICIPIO_UF=XX

# Banco
DATABASE_URL=jdbc:postgresql://localhost:5432/caqi
DATABASE_USER=caqi
DATABASE_PASSWORD=caqi_dev_password

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=caqi
RABBITMQ_USER=caqi
RABBITMQ_PASSWORD=caqi_dev_password

# Eventos (false desliga publicação no exchange caqi.events)
CAQI_EVENTS_ENABLED=true

# Observabilidade
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Compliance enforcers
CAQI_COMPLIANCE_FUNDEB_70=true
CAQI_COMPLIANCE_VAAT_15=true
CAQI_COMPLIANCE_MDE_25=true

# Auth — MVP HTTP Basic; Substituir por Gov.br OAuth2 em produção (Fase 9).
# GERAR senhas fortes com: openssl rand -hex 24
CAQI_LEITOR_USERNAME=leitor
CAQI_LEITOR_PASSWORD=trocar_em_prod_use_openssl_rand
CAQI_GESTOR_USERNAME=gestor
CAQI_GESTOR_PASSWORD=trocar_em_prod_use_openssl_rand
CAQI_ADMIN_USERNAME=admin
CAQI_ADMIN_PASSWORD=trocar_em_prod_use_openssl_rand
