{
  "info": {
    "name": "CAQ/CAQi — API Collection",
    "_postman_id": "caq-collection-001",
    "description": "Coleção Postman para testes rápidos do Sistema CAQ/CAQi — alinhada ao esqueleto OpenAPI 3.1 entregue.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://sandbox.seu-municipio.gov.br/caq"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "CAQi — Parâmetros",
      "item": [
        {
          "name": "GET /caqi/parametros",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/caqi/parametros",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "caqi",
                "parametros"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', ()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT /caqi/parametros",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"etapaId\": \"EF1\",\n  \"tempo\": \"parcial\",\n  \"alunosPorTurma\": 25,\n  \"cargaHorariaDocenteHSem\": 20,\n  \"jornadaDiasAno\": 200,\n  \"coefRural\": 1.0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/caqi/parametros",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "caqi",
                "parametros"
              ]
            }
          }
        }
      ]
    },
